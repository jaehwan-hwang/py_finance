# 멘토 전용 열쇠. 아직 열리지 않은 주차를 미리 보기 위한 값이다.
#
#   로컬  : 이 파일을 .env.local 로 복사하고 값을 채운다
#   Vercel: Project → Settings → Environment Variables 에 MENTOR_KEY 로 등록
#
# 등록한 뒤 https://financepy.site/mentor?key=여기에_적은_값 으로 한 번 접속하면
# 브라우저에 쿠키가 저장되어 이후로는 계속 전부 볼 수 있다.
# 해제는 /mentor?logout=1
#
# 값이 비어 있으면 아무도 통과하지 못한다(전부 잠김).
MENTOR_KEY=
